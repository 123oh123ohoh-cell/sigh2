// Pug template for signup.html
//- Signup Page

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Create Account - own's hub
    link(rel="stylesheet" href="styles.css")
    link(rel="icon" type="image/png" href="logo2.png")
  body
    .auth-container
      h2 Create Account
      form#signupForm
        input#signupUsername(type="text" placeholder="Username" required)
        input#signupPassword(type="password" placeholder="Password" required)
        button(type="submit") Sign Up
      p Already have an account? 
        a(href="login.html") Log in
    script(src="script.js")
